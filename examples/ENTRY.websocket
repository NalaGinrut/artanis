;; This an Artanis ENTRY file, don't remove it!

 (use-modules (artanis artanis)
              ;; Put modules you want to be imported here
              ;; only for this file, not controllers/views

              (artanis utils))
 ;; Put whatever you want to be called before server initilization here

 (init-server #:statics '(png gif jpg jpeg ico html js json csv xml css woff woff2 ttf))
 (add-to-load-path (string-append (current-toplevel) "/lib"))
 ;; Put whatever you want to be called before server running here

 ;; A WebSocket route handler is called once for each connection, with the rc
 ;; of the handshake, and returns the dispatcher of the connection. A
 ;; procedure is the short form of #:on-message.
 (get "/echo" #:websocket 'raw
      (lambda (rc) (lambda (conn msg) (ws-send conn msg))))
 (get "/quiet" #:websocket 'raw
      (lambda (rc) (lambda (conn msg) #t)))
 (get "/boom" #:websocket 'raw
      (lambda (rc)
        (lambda (conn msg)
          (let ((s (ws-message-text msg)))
            (cond
             ((string=? s "404") (throw 'artanis-err 404 'boom "nope"))
             ((string=? s "scheme") (car '()))
             (else (throw 'artanis-err 500 'boom "boom")))))))
 (get "/short" #:websocket 'raw #:timeout 2
      (lambda (rc) (lambda (conn msg) (ws-send conn msg))))
 (get "/hello" (lambda (rc) "hello"))

 ;; AuthN (layer 3): log in by HTTP, then the handshake carries the sid cookie.
 ;; websocket-auth-test.py needs in conf/artanis.conf:
 ;;   cookie.expires = 4
 ;;   server.origins = http://localhost:5173
 (get "/login" #:session #t
      (lambda (rc) (:session rc 'spawn) "ok"))
 (get "/logout" #:session #t
      (lambda (rc)
        ((@ (artanis session) session-destroy!)
         ((@ (artanis route) get-sid-from-client-cookie) rc))
        "bye"))
 (get "/secure" #:websocket 'raw #:with-auth 'status #:timeout 0
      (lambda (rc) (lambda (conn msg) (ws-send conn msg))))

 ;; ---------------------------------------------------------------------------
 ;; Connection API (layer 4), for websocket-test.py.
 ;; A connection opened with ?sub=NAME is registered as NAME for pushing, and
 ;; how it was closed is kept for /closed/NAME.
 ;; NOTE: This registry is only for the tests of layer 4. The way to reach
 ;;       connections is topics, see the Topics section below.

 (define *subs* (make-hash-table))
 (define *closed* (make-hash-table))

 (define* (subscriber rc #:optional (on-message (lambda (conn msg) (ws-send conn msg))))
   (let ((name (params rc "sub")))
     (ws-dispatcher
      #:on-open (lambda (conn) (when name (hash-set! *subs* name conn)))
      #:on-message on-message
      #:on-close (lambda (conn code reason)
                   (when name
                     (hash-remove! *subs* name)
                     (hash-set! *closed* name (format #f "~a ~a" code reason)))))))

 (define (->reply r) (format #f "~a" r))

 ;; Echo, registered by ?sub=NAME.
 (get "/sub" #:websocket 'raw #:timeout 0
      (lambda (rc) (subscriber rc)))
 (get "/sub-short" #:websocket 'raw #:timeout 2
      (lambda (rc) (subscriber rc)))
 (get "/sub-slow" #:websocket '(raw #:overflow close) #:timeout 0
      (lambda (rc) (subscriber rc)))

 ;; Push from an HTTP request: the text, or n buffers of size bytes.
 ;; Replies with the result of each ws-send, or "none".
 (get "/push/:name"
      (lambda (rc)
        (let ((conn (hash-ref *subs* (params rc "name")))
              (n (string->number (or (params rc "n") "1")))
              (size (and=> (params rc "size") string->number)))
          (if conn
              (string-join
               (map (lambda (_)
                      (->reply
                       (ws-send conn (if size
                                         (make-ws-buffer size)
                                         (or (params rc "msg") "pushed")))))
                    (iota n))
               " ")
              "none"))))

 ;; Push from a runner thread.
 (get "/runner-push/:name"
      (lambda (rc)
        (let ((conn (hash-ref *subs* (params rc "name"))))
          (if conn
              (->reply (call-with-runner
                        (lambda () (ws-send conn "from runner"))))
              "none"))))

 (get "/closed/:name"
      (lambda (rc) (or (hash-ref *closed* (params rc "name")) "open")))

 ;; A runner in on-message: the reply comes when the runner is done.
 (get "/slow" #:websocket 'raw #:timeout 0
      (lambda (rc)
        (lambda (conn msg)
          (let ((s (ws-message-text msg)))
            (ws-send conn (call-with-runner
                           (lambda () (usleep 300000) (string-upcase s))))))))

 ;; Close by the server: "close" -> 4000 "bye", then ws-send is 'closed.
 (get "/ctl" #:websocket 'raw #:timeout 0
      (lambda (rc)
        (subscriber
         rc
         (lambda (conn msg)
           (let ((s (ws-message-text msg)))
             (cond
              ((string=? s "close")
               (ws-send conn "before close")
               (ws-close! conn #:code 4000 #:reason "bye")
               (hash-set! *closed* "after-close" (->reply (ws-send conn "x"))))
              ((string=? s "binary")
               (ws-send conn (string->ws-buffer "bin")))
              ((string=? s "text-buffer")
               (ws-send conn (string->ws-buffer "txt") #:type 'text))
              (else (ws-send conn s))))))))

 ;; Invalid route handlers.
 (get "/not-dispatcher" #:websocket 'raw
      (lambda (rc) 42))
 (get "/handler-403" #:websocket 'raw
      (lambda (rc) (throw 'artanis-err 403 'handler-403 "no")))
 (get "/welcome" #:websocket 'raw
      (lambda (rc)
        (ws-dispatcher
         #:on-open (lambda (conn) (ws-send conn "welcome"))
         #:on-message (lambda (conn msg) (ws-send conn msg)))))

 ;; ---------------------------------------------------------------------------
 ;; Application protocols, for websocket-test.py.
 ;; '(proto chat) is JSON in text frames: copy examples/protocols/chat.scm to
 ;; app/protocols/. The handler deals with objects only, the client must ask
 ;; for the subprotocol `chat'.

 (get "/room/:id" #:websocket '(proto chat) #:timeout 0
      (lambda (rc)
        (let ((room (params rc "id")))
          (subscriber
           rc
           (lambda (conn obj)
             (let ((text (assoc-ref obj "text")))
               (cond
                ((equal? text "pre")
                 (ws-send conn (ws-pre-encode 'chat `(("room" . ,room)
                                                      ("text" . "pre")))))
                ((equal? text "raw")
                 (ws-send conn "raw!" #:raw #t))
                ((equal? text "bad-encode")
                 ;; Not JSON, the encode error closes it with 1011.
                 (ws-send conn (lambda () #t)))
                (else
                 (ws-send conn `(("room" . ,room) ("text" . ,text)))))))))))

 ;; The builtin `echo': any frame type, the identity codec.
 (get "/echo-proto" #:websocket '(proto echo)
      (lambda (rc) (lambda (conn msg) (ws-send conn msg))))

 ;; Push an object to a connection registered by ?sub=NAME, from an HTTP
 ;; request, or from a runner thread with ?runner=1. ?pre=1 encodes it once
 ;; with ws-pre-encode, which only a '(proto chat) connection takes.
 (get "/push-obj/:name"
      (lambda (rc)
        (let ((conn (hash-ref *subs* (params rc "name")))
              (obj `(("pushed" . ,(or (params rc "msg") "obj")))))
          (cond
           ((not conn) "none")
           ((params rc "runner")
            (->reply (call-with-runner (lambda () (ws-send conn obj)))))
           ((params rc "pre")
            (catch 'artanis-err
              (lambda () (->reply (ws-send conn (ws-pre-encode 'chat obj))))
              (lambda _ "rejected")))
           (else (->reply (ws-send conn obj)))))))

 ;; ---------------------------------------------------------------------------
 ;; Topics, for websocket-auth-test.py. Only an authenticated connection can
 ;; subscribe.
 ;; NOTE: The topic is taken from ?t= only for the tests, a real application
 ;;       chooses it on the server, e.g. from the session.

 (get "/topic" #:websocket 'raw #:with-auth 'status #:timeout 0
      (lambda (rc)
        (ws-dispatcher
         #:on-open (lambda (conn)
                     (ws-subscribe! conn (params rc "t")
                                    #:exclusive? (equal? (params rc "x") "1")))
         #:on-message (lambda (conn msg) (ws-send conn msg)))))

 ;; The same with the `chat' protocol: published objects are encoded.
 (get "/topic-chat" #:websocket '(proto chat) #:with-auth 'status #:timeout 0
      (lambda (rc)
        (ws-dispatcher
         #:on-open (lambda (conn) (ws-subscribe! conn (params rc "t")))
         #:on-message (lambda (conn obj) (ws-send conn obj)))))

 ;; Not authenticated: ws-subscribe! fails in on-open, closed with 1011.
 (get "/topic-noauth" #:websocket 'raw #:timeout 0
      (lambda (rc)
        (ws-dispatcher
         #:on-open (lambda (conn) (ws-subscribe! conn "t"))
         #:on-message (lambda (conn msg) #t))))

 ;; Publish to a topic, replies with the number of subscribers it's queued
 ;; for. ?obj=1 publishes an object (a JSON object for `chat').
 (get "/publish/:topic"
      (lambda (rc)
        (let ((msg (or (params rc "msg") "pub")))
          (->reply (ws-publish (params rc "topic")
                               (if (params rc "obj")
                                   `(("msg" . ,msg))
                                   msg))))))
