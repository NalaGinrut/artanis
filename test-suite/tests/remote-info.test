(define-module (test remote-info)
  #:use-module (artanis utils)
  #:use-module (artanis config)
  #:use-module (web request)
  #:use-module (web uri)
  #:use-module (test-suite lib))

;; A request on the server side of a TCP connection from 127.0.0.1.
(define* (tcp-request #:optional (headers '()))
  (let ((l (socket AF_INET SOCK_STREAM 0))
        (c (socket AF_INET SOCK_STREAM 0)))
    (bind l AF_INET INADDR_LOOPBACK 0)
    (listen l 1)
    (connect c AF_INET INADDR_LOOPBACK (sockaddr:port (getsockname l)))
    (build-request (string->uri "http://localhost/")
                   #:headers headers
                   #:port (car (accept l)))))

(define (with-nginx nginx? thunk)
  (let ((old (get-conf '(server nginx))))
    (conf-set! '(server nginx) nginx?)
    (let ((r (thunk)))
      (conf-set! '(server nginx) old)
      r)))

(with-test-prefix "remote-info"

  (pass-if-equal "the peer" "127.0.0.1"
    (with-nginx #f (lambda () (remote-info (tcp-request)))))

  (pass-if-equal "X-Real-IP is ignored without nginx" "127.0.0.1"
    (with-nginx #f
      (lambda ()
        (remote-info (tcp-request '((x-real-ip . "10.0.0.1")))))))

  (pass-if-equal "X-Real-IP behind nginx" "10.0.0.1"
    (with-nginx #t
      (lambda ()
        (remote-info (tcp-request '((x-real-ip . "10.0.0.1")))))))

  (pass-if-equal "the peer behind nginx without X-Real-IP" "127.0.0.1"
    (with-nginx #t (lambda () (remote-info (tcp-request))))))
