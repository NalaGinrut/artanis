(define-module (test exception)
  #:use-module (artanis utils)
  #:use-module (test-suite lib))

;; The generator returns 3 values like render-sys-page does.
(define (gen status) (values 'response status 'exception))

;; Throw with the given args, catch it like Ragnarok does, return the status
;; passed to the generator.
(define (status-of . args)
  (call-with-values
      (lambda ()
        (catch 'artanis-err
          (lambda () (apply throw 'artanis-err args))
          (lambda e
            (parameterize ((current-error-port (%make-void-port "w")))
              (apply (make-unstop-exception-handler gen) e)))))
    (lambda (r status s) status)))

(with-test-prefix "unstop exception handler"

  (pass-if-equal "valid shape with symbol" 404
    (status-of 404 'foo "not found ~a" 1))

  (pass-if-equal "valid shape with procedure" 403
    (status-of 403 car "forbidden"))

  (pass-if-equal "no status" 500
    (status-of car "no status ~a" 1))

  (pass-if-equal "no proc-name" 500
    (status-of 500 "no proc-name ~a" 1))

  (pass-if-equal "no fmt" 500
    (status-of 500 'foo))

  (pass-if-equal "nothing" 500
    (status-of)))
