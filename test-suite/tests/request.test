(define-module (test request)
  #:use-module (artanis utils)
  #:use-module (artanis server request)
  #:use-module (artanis server server-context)
  #:use-module (ice-9 binary-ports)
  #:use-module (ice-9 threads)
  #:use-module (ice-9 receive)
  #:use-module (rnrs bytevectors)
  #:use-module (web request)
  #:use-module (web uri)
  #:use-module (test-suite lib))

(define (port-of str)
  (open-bytevector-input-port (string->utf8 str)))

;; The status of the artanis-err thrown by thunk, or #f.
(define (status-of thunk)
  (catch 'artanis-err
    (lambda () (thunk) #f)
    (lambda (k status . _) status)))

(define simple "GET /a?b=1 HTTP/1.1\r\nHost: localhost\r\nX-Foo: bar\r\n\r\n")

(with-test-prefix "request head"

  (pass-if "a request is parsed, its port is the given port"
    (let ((port (port-of (string-append simple "BODY"))))
      (receive (req size) (read-request-head port 1024)
        (and (eq? 'GET (request-method req))
             (equal? "/a" (uri-path (request-uri req)))
             (equal? "bar" (assq-ref (request-headers req) 'x-foo))
             (eq? port (request-port req))
             (= size (string-length simple))
             ;; The body is left in the port.
             (equal? "BODY" (utf8->string (get-bytevector-all port)))))))

  (pass-if "LF-only line endings are accepted"
    (receive (req size)
        (read-request-head (port-of "GET / HTTP/1.1\nHost: h\n\n") 1024)
      (and (eq? 'GET (request-method req)) (= size 24))))

  (pass-if "empty lines before the request line are ignored"
    (receive (req size)
        (read-request-head (port-of (string-append "\r\n\r\n" simple)) 1024)
      (and (equal? "/a" (uri-path (request-uri req)))
           (= size (+ 4 (string-length simple))))))

  (pass-if "EOF before anything"
    (receive (req size) (read-request-head (port-of "") 1024)
      (and (eof-object? req) (zero? size))))

  (pass-if "EOF after empty lines only"
    (receive (req size) (read-request-head (port-of "\r\n") 1024)
      (eof-object? req)))

  (pass-if-equal "EOF in the middle of the head is 400" 400
    (status-of (lambda ()
                 (read-request-head (port-of "GET / HTTP/1.1\r\nHost: h\r\n")
                                    1024))))

  (pass-if "a head of exactly the limit is accepted"
    (receive (req size)
        (read-request-head (port-of simple) (string-length simple))
      (= size (string-length simple))))

  (pass-if-equal "a too long request line is 414" 414
    (status-of (lambda ()
                 (read-request-head
                  (port-of (string-append "GET /" (make-string 100 #\a)
                                          " HTTP/1.1\r\n\r\n"))
                  64))))

  (pass-if-equal "too long header fields are 431" 431
    (status-of (lambda ()
                 (read-request-head
                  (port-of (string-append "GET / HTTP/1.1\r\nHost: h\r\n"
                                          "X-Big: " (make-string 100 #\a)
                                          "\r\n\r\n"))
                  64))))

  (pass-if-equal "too many header fields are 431" 431
    (status-of (lambda ()
                 (read-request-head
                  (port-of (string-append
                            "GET / HTTP/1.1\r\n"
                            (apply string-append
                                   (map (lambda (i) (format #f "X-~a: 1\r\n" i))
                                        (iota 100)))
                            "\r\n"))
                  256))))

  (pass-if-equal "a bad header is thrown by Guile" 'bad-header
    (catch #t
      (lambda ()
        (read-request-head (port-of "GET / HTTP/1.1\r\nNoColon\r\n\r\n")
                           1024)
        #f)
      (lambda (k . _) k))))

;; Read deadlines

(define (new-client)
  (let ((p (socketpair PF_UNIX SOCK_STREAM 0)))
    (new-ragnarok-client (list (car p)))))

(define (new-wt) (make-work-table (make-hash-table) (make-mutex)))

(define (client+task wt)
  (let* ((c (new-client))
         (t (make-task c (current-time) 60 #f #f #t)))
    (add-a-task-to-work-table! wt c t)
    c))

(define deadline-queue
  (@@ (artanis server server-context) *read-deadline-queue*))
(define deadlines (@@ (artanis server server-context) *read-deadlines*))

(define (reset-deadlines!)
  (while (not (queue-empty? deadline-queue))
    (queue-out! deadline-queue)))

(define (queued) (queue-length deadline-queue))

;; Move the deadline of client and its items `ago' seconds into the past.
(define (age! client ago)
  (let ((delta (* ago internal-time-units-per-second))
        (entry (hashq-ref deadlines client)))
    (for-each (lambda (item)
                (when (eq? (car item) client)
                  (set-cdr! item (- (cdr item) delta))))
              (car deadline-queue))
    (when (car entry) (set-car! entry (- (car entry) delta)))
    (when (cdr entry) (set-cdr! entry (- (cdr entry) delta)))))

(with-test-prefix "read deadline"

  (pass-if "a passed deadline is taken"
    (reset-deadlines!)
    (let* ((wt (new-wt)) (c (client+task wt)))
      (read-deadline-set! c 5)
      (age! c 5)
      (and (read-deadline-passed? c)
           (equal? (list c) (take-read-deadline-due! wt))
           (zero? (queued)))))

  (pass-if "a deadline not passed yet isn't taken"
    (reset-deadlines!)
    (let* ((wt (new-wt)) (c (client+task wt)))
      (read-deadline-set! c 5)
      (age! c 4)
      (and (not (read-deadline-passed? c))
           (null? (take-read-deadline-due! wt))
           (= 1 (queued)))))

  (pass-if "only the due head is taken, in the order of the deadlines"
    (reset-deadlines!)
    (let* ((wt (new-wt)) (a (client+task wt)) (b (client+task wt))
           (c (client+task wt)))
      (read-deadline-set! a 5)
      (read-deadline-set! b 5)
      (read-deadline-set! c 5)
      (age! a 5)
      (age! b 5)
      (and (equal? (list b a) (take-read-deadline-due! wt))
           (= 1 (queued)))))

  (pass-if "a deadline moved far enough has a new item"
    (reset-deadlines!)
    (let* ((wt (new-wt)) (c (client+task wt)))
      (read-deadline-set! c 5)
      (age! c 5)
      ;; e.g. the next request of a kept-alive connection
      (read-deadline-set! c 5)
      (and (= 2 (queued))
           ;; The old item is stale, the new one isn't due.
           (null? (take-read-deadline-due! wt))
           (= 1 (queued)))))

  (pass-if "a deadline moved a little is enqueued again when due"
    (reset-deadlines!)
    (let* ((wt (new-wt)) (c (client+task wt)))
      (read-deadline-set! c 5)
      (age! c 5)
      ;; The deadline moves by 0.5s, e.g. a piece of the body.
      (set-car! (hashq-ref deadlines c)
                (+ (car (hashq-ref deadlines c))
                   (quotient internal-time-units-per-second 2)))
      (and (= 1 (queued))
           (null? (take-read-deadline-due! wt))
           (= 1 (queued))
           (not (read-deadline-passed? c)))))

  (pass-if "a body coming in small pieces doesn't flood the queue"
    (reset-deadlines!)
    (let* ((wt (new-wt)) (c (client+task wt)))
      (for-each (lambda (_) (read-deadline-set! c 5)) (iota 100))
      (= 1 (queued))))

  (pass-if "a cleared deadline drops its item"
    (reset-deadlines!)
    (let* ((wt (new-wt)) (c (client+task wt)))
      (read-deadline-set! c 5)
      (age! c 5)
      (read-deadline-clear! c)
      (and (not (read-deadline-passed? c))
           (null? (take-read-deadline-due! wt))
           (zero? (queued))
           ;; The next deadline enqueues a new item.
           (begin (read-deadline-set! c 5) (= 1 (queued))))))

  (pass-if "a closed connection drops its item"
    (reset-deadlines!)
    (let* ((wt (new-wt)) (c (client+task wt)))
      (read-deadline-set! c 5)
      (age! c 5)
      (hash-clear! (work-table-content wt))
      (and (null? (take-read-deadline-due! wt))
           (zero? (queued))
           (not (hashq-ref deadlines c))))))

;; Body framing

(define (head-of str)
  (receive (req size) (read-request-head (port-of str) 4096) req))

(define (framing-of str)
  (catch 'artanis-err
    (lambda () (request-body-framing (head-of str)))
    (lambda (k status . _) status)))

(with-test-prefix "body framing"

  (pass-if-equal "no body" 0
    (framing-of "GET / HTTP/1.1\r\nHost: h\r\n\r\n"))

  (pass-if-equal "Content-Length" 12
    (framing-of "POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 12\r\n\r\n"))

  (pass-if-equal "the same Content-Length twice" 12
    (framing-of (string-append "POST / HTTP/1.1\r\nHost: h\r\n"
                               "Content-Length: 12\r\nContent-Length: 12\r\n\r\n")))

  (pass-if-equal "different Content-Length values are 400" 400
    (framing-of (string-append "POST / HTTP/1.1\r\nHost: h\r\n"
                               "Content-Length: 12\r\nContent-Length: 13\r\n\r\n")))

  (pass-if-equal "chunked" 'chunked
    (framing-of (string-append "POST / HTTP/1.1\r\nHost: h\r\n"
                               "Transfer-Encoding: chunked\r\n\r\n")))

  (pass-if-equal "chunked is case-insensitive" 'chunked
    (framing-of (string-append "POST / HTTP/1.1\r\nHost: h\r\n"
                               "Transfer-Encoding: Chunked\r\n\r\n")))

  (pass-if-equal "Transfer-Encoding with Content-Length is 400" 400
    (framing-of (string-append "POST / HTTP/1.1\r\nHost: h\r\n"
                               "Content-Length: 3\r\n"
                               "Transfer-Encoding: chunked\r\n\r\n")))

  (pass-if-equal "Transfer-Encoding in HTTP/1.0 is 400" 400
    (framing-of (string-append "POST / HTTP/1.0\r\nHost: h\r\n"
                               "Transfer-Encoding: chunked\r\n\r\n")))

  (pass-if-equal "chunked not final is 400" 400
    (framing-of (string-append "POST / HTTP/1.1\r\nHost: h\r\n"
                               "Transfer-Encoding: chunked, gzip\r\n\r\n")))

  (pass-if-equal "chunked not final over two fields is 400" 400
    (framing-of (string-append "POST / HTTP/1.1\r\nHost: h\r\n"
                               "Transfer-Encoding: chunked\r\n"
                               "Transfer-Encoding: gzip\r\n\r\n")))

  (pass-if-equal "another coding is 501" 501
    (framing-of (string-append "POST / HTTP/1.1\r\nHost: h\r\n"
                               "Transfer-Encoding: gzip, chunked\r\n\r\n"))))

;; Chunked bodies

(define (chunked str limit)
  (catch 'artanis-err
    (lambda ()
      (let ((port (port-of str)))
        (let ((bv (read-chunked-body port limit)))
          (list (and bv (utf8->string bv))
                (let ((rest (get-bytevector-all port)))
                  (if (eof-object? rest) "" (utf8->string rest)))))))
    (lambda (k status . _) status)))

(with-test-prefix "chunked body"

  (pass-if-equal "chunks are joined, the rest is left"
      '("hello, world" "NEXT")
    (chunked "5\r\nhello\r\n7\r\n, world\r\n0\r\n\r\nNEXT" 1024))

  (pass-if-equal "hex sizes, extensions and trailers"
      (list (make-string 26 #\x) "")
    (chunked (string-append "1A;name=value\r\n" (make-string 26 #\x)
                            "\r\n0\r\nX-Trailer: 1\r\n\r\n")
             1024))

  (pass-if-equal "LF-only line endings" '("abc" "")
    (chunked "3\nabc\n0\n\n" 1024))

  (pass-if-equal "an empty body is #f" '(#f "")
    (chunked "0\r\n\r\n" 1024))

  (pass-if-equal "too large is 413" 413
    (chunked "10\r\n0123456789abcdef\r\n0\r\n\r\n" 10))

  (pass-if-equal "a huge chunk size is 413, nothing allocated" 413
    (chunked "ffffffffffffffffffff\r\n" 1024))

  (pass-if-equal "an invalid chunk size is 400" 400
    (chunked "zz\r\nabc\r\n0\r\n\r\n" 1024))

  (pass-if-equal "a signed chunk size is 400" 400
    (chunked "+3\r\nabc\r\n0\r\n\r\n" 1024))

  (pass-if-equal "no CRLF after the data is 400" 400
    (chunked "3\r\nabcd\r\n0\r\n\r\n" 1024))

  (pass-if-equal "EOF in the middle is 400" 400
    (chunked "5\r\nab" 1024)))
