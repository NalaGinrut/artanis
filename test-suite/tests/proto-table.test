(define-module (test proto-table)
  #:use-module (artanis env)
  #:use-module (artanis server server-context)
  #:use-module (ice-9 threads)
  #:use-module (test-suite lib))

(define *test-proto*
  (make-ragnarok-protocol 'test-proto #f #f #f #f))
(protocol-add! 'test-proto *test-proto*)

(define (new-client)
  (let ((p (socketpair PF_UNIX SOCK_STREAM 0)))
    (new-ragnarok-client (list (car p)))))

(define (new-wt) (make-work-table (make-hash-table) (make-mutex)))

(with-test-prefix "proto table"

  (pass-if "a plain connection has no protocol"
    (not (specified-proto? (new-client))))

  (pass-if-equal "register with state" (list *test-proto* 'st)
    (let ((c (new-client)))
      (register-proto! c 'test-proto 'st)
      (list (specified-proto? c) (proto-conn-state c))))

  (pass-if-equal "unknown protocol" 500
    (catch 'artanis-err
      (lambda () (register-proto! (new-client) 'no-such-proto) 'no-error)
      (lambda (k status . _) status)))

  (pass-if "the entry doesn't survive its connection"
    ;; Close through remove-from-work-table!, then take the same fd number
    ;; for a new connection: it must be a plain connection.
    (let* ((c (new-client))
           (fd (port->fdes (car ((@@ (artanis server server-context) unbox-type) c)))))
      (register-proto! c 'test-proto 'st)
      (remove-from-work-table! (new-wt) c #f)
      (let lp ((n 0))
        (let ((c2 (new-client)))
          (cond
           ((= fd (client-sockport-descriptor c2))
            (not (specified-proto? c2)))
           ((> n 16) (throw 'test-err "fd was not reused"))
           (else (lp (1+ n)))))))))
